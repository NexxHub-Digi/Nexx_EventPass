# Configure in Vercel, never commit real values
DATABASE_URL=postgresql://user:password@host/eventpass?sslmode=require
AUTH_SECRET=replace-with-a-unique-at-least-32-character-secret
QR_SIGNING_SECRET=replace-with-a-different-unique-at-least-32-character-secret
ORGANISER_INVITE_CODE=replace-with-a-private-invitation-code
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth clients (server-side; never NEXT_PUBLIC_)
GOOGLE_GUEST_CLIENT_ID=
GOOGLE_GUEST_CLIENT_SECRET=
GOOGLE_ORGANISER_CLIENT_ID=
GOOGLE_ORGANISER_CLIENT_SECRET=
GOOGLE_GATE_CLIENT_ID=
GOOGLE_GATE_CLIENT_SECRET=
GOOGLE_PLATFORM_CLIENT_ID=
GOOGLE_PLATFORM_CLIENT_SECRET=
# OAuth callback origin must be registered with each Google Web OAuth client
NEXT_PUBLIC_SITE_URL=https://nexx-eventpass.vercel.app
