{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_RELEASE_CHANNEL": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    }
  }
}
