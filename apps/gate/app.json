{
  "expo": {
    "name": "Nexx EventPass Gate Operator",
    "slug": "nexx-eventpass-gate",
    "scheme": "eventpassgate",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.nexx.eventpass.gate",
      "supportsTablet": true
    },
    "android": {
      "package": "com.nexx.eventpass.gate",
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#231b4d"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow EventPass Gate Operator to scan tickets.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "icon": "./assets/app-icon.png"
  }
}
